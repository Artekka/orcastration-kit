{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/discard-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/pkill-full-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/prettier-dir-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/conflict-marker-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/secrets-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sendmessage-sha-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/secrets-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx-guard.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ctx-guard.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
